{
  "//": "tsconfig-schema:ignore",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,

    /* === Módulos y compatibilidad === */
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],

    /* === Seguridad del compilador === */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* === JS / compatibilidad === */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* === Alias === */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@config/*": ["config/*"],
      "@modules/*": ["modules/*"],
      "@routes/*": ["modules/*/**/routes/*"],
      "@controllers/*": ["modules/*/**/controllers/*"],
      "@services/*": ["modules/*/**/services/*"],
      "@models/*": ["modules/*/**/models/*", "models/*"],
      "@utils/*": ["utils/*"]
    },

    /* === Performance === */
    "noUncheckedIndexedAccess": false,
    "incremental": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/modules/nombre_grupo_ejemplo/**"
  ]
}
